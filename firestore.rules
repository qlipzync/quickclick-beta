rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    function isMasterAdmin() {
      return isAuthenticated() && (
        (request.auth.token.email != null && request.auth.token.email.lower() == 'robert.f.telekom@gmail.com') ||
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin'
      );
    }
    function hasActiveSubscription(userId) {
      return isMasterAdmin() || request.auth.token.subscribed == true || request.auth.token.hasActiveSubscription == true;
    }
    function canCreateNonPrivilegedUser() {
      return
        (!('role' in request.resource.data) || request.resource.data.role == 'streamer') &&
        (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false) &&
        (!('isTitanVip' in request.resource.data) || request.resource.data.isTitanVip == false) &&
        (!('hasActiveSubscription' in request.resource.data) || request.resource.data.hasActiveSubscription == false) &&
        (!('subscriptionPlan' in request.resource.data) || request.resource.data.subscriptionPlan == 'free') &&
        (!('subscriptionStatus' in request.resource.data) || request.resource.data.subscriptionStatus == 'inactive') &&
        (!('adminOverrideActive' in request.resource.data) || request.resource.data.adminOverrideActive == false) &&
        (!('clipsLimitTotal' in request.resource.data) || request.resource.data.clipsLimitTotal == 0) &&
        (!('apiCallsLimit' in request.resource.data) || request.resource.data.apiCallsLimit == 0) &&
        (!('clipBalance' in request.resource.data) || request.resource.data.clipBalance == 0) &&
        (!('dailyClipCount' in request.resource.data) || request.resource.data.dailyClipCount == 0) &&
        (!('subscriptionTierLevel' in request.resource.data) || request.resource.data.subscriptionTierLevel == 0) &&
        (!('plan' in request.resource.data) || request.resource.data.plan == 'none' || request.resource.data.plan == 'free') &&
        !request.resource.data.keys().hasAny(['stripeCustomerId', 'stripeSubscriptionId', 'billingCycle']);
    }

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isMasterAdmin();
      // Clients may create their own profile, but RBAC and billing fields are server-managed.
      allow create: if isOwner(userId) &&
        !request.resource.data.keys().hasAny([
          'role', 'isAdmin', 'subscriptionPlan', 'hasActiveSubscription',
          'adminOverrideActive', 'clipsLimitTotal', 'subscriptionStatus',
          'subscriptionTierLevel', 'clipBalance', 'dailyClipCount',
          'isTitanVip', 'billingCycle', 'stripeCustomerId', 'stripeSubscriptionId'
        ]);
      allow update: if (
        isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role', 'isAdmin', 'subscriptionPlan', 'hasActiveSubscription', 'adminOverrideActive', 'clipsLimitTotal', 'subscriptionStatus', 'subscriptionTierLevel', 'clipBalance', 'dailyClipCount', 'isTitanVip', 'billingCycle', 'stripeCustomerId', 'stripeSubscriptionId', 'apiCallsLimit', 'plan'
        ])
      ) || isMasterAdmin();
      allow delete: if isMasterAdmin();
    }

    match /users/{userId}/integrations/{platform} {
      allow read: if isOwner(userId) || isMasterAdmin();
      allow write: if isMasterAdmin(); // Nur Backend darf verschlüsselte Tokens schreiben
    }

    match /users/{userId}/apiKeys/{keyId} {
      allow read: if isOwner(userId) || isMasterAdmin();
      allow write: if isMasterAdmin(); // Nur das sichere Cloud Run API Gateway darf Hashes schreiben/widerrufen
    }

    match /users/{userId}/channelConfigs/{configId} {
      allow read: if isOwner(userId) || isMasterAdmin();
      allow write: if (isOwner(userId) && hasActiveSubscription(userId)) || isMasterAdmin();
    }

    match /users/{userId}/wallet/{document=**} {
      allow read: if isOwner(userId) || isMasterAdmin();
      allow write: if false; // Ausschließlich über Cloud Run Backend Ledger veränderbar
    }

    match /users/{userId}/clips/{clipId} {
      allow read, write: if isOwner(userId) || isMasterAdmin();
    }

    match /users/{userId}/invoices/{invoiceId} {
      allow read: if isOwner(userId) || isMasterAdmin();
      allow write: if isMasterAdmin();
    }

    match /clips/{clipId}/ai_metadata/{metaId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isMasterAdmin());
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isMasterAdmin());
      allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isMasterAdmin());
    }

    match /bots/{botId}/logs/{logId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isMasterAdmin());
      allow write: if isMasterAdmin();
    }
  }
}