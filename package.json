{
  "name": "qlipzync",
  "version": "7.0.0",
  "description": "QuickClick SaaS Platform with Extended 7-Stage Pipeline & Zero-Storage Processing",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && esbuild server/*.ts server/middleware/*.ts server/routes/*.ts server/schemas/*.ts server/services/*.ts server/utils/*.ts --outdir=server --outbase=server --format=esm --platform=node --packages=external && esbuild server.ts --outfile=dist/server.js --format=esm --platform=node --bundle --packages=external --target=node22",
    "start": "node dist/server.js",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "NODE_ENV=test node --import tsx --test tests/server.test.ts tests/production-readiness.test.mjs",
    "test:rules": "node --test tests/firestore.rules.test.mjs",
    "test:ci": "npm run lint && npm test && npm run test:rules"
  },
  "dependencies": {
    "@google-cloud/tasks": "^7.2.1",
    "@google-cloud/vertexai": "^1.12.0",
    "@google/genai": "2.24.0",
    "@stripe/stripe-js": "^9.16.0",
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "cors": "^2.8.6",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.3.0",
    "lucide-react": "^0.475.0",
    "motion": "^13.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-is": "^19.3.0",
    "recharts": "^3.10.1",
    "stripe": "^22.6.2",
    "tailwindcss": "^4.0.0",
    "vite": "^6.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "tsx": "^4.23.13",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.70.1",
    "@firebase/rules-unit-testing": "^4.0.1"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6",
    "uuid": "^11.1.1",
    "@firebase/rules-unit-testing": {
      "firebase": "$firebase"
    }
  }
}
